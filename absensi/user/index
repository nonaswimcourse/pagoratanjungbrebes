<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Absen Mandiri — Scan QR</title>
  <link rel="stylesheet" href="../style.css">
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="https://unpkg.com/html5-qrcode"></script>
  <style>
    /* Halaman ini sengaja dibuat sangat sederhana: HANYA kamera scan.
       Tidak ada menu Peserta, Rekap, Kartu ID, atau pengaturan apa pun,
       supaya aman dibagikan ke peserta. */
    .app{max-width:560px}
    .scan-head{display:flex;align-items:center;gap:10px;margin-bottom:14px}
    .scan-head .logo{width:40px;height:40px;border-radius:11px;flex:none;display:flex;
      align-items:center;justify-content:center;background:#0f6fde;color:#fff;
      font-weight:800;font-size:14px;overflow:hidden}
    .scan-head .logo img{width:100%;height:100%;object-fit:cover}
    .scan-head .t1{font-size:17px;font-weight:800;line-height:1.2}
    .scan-head .t2{font-size:12px;color:var(--muted);word-break:break-all}
    .scan-head .spacer{flex:1}
    .mini-logout{background:none;border:1px solid var(--border);color:var(--muted);
      border-radius:10px;padding:7px 11px;font-size:13px;cursor:pointer;flex:none}
    .riwayat{list-style:none;margin:10px 0 0;padding:0;font-size:13px}
    .riwayat li{display:flex;justify-content:space-between;gap:10px;padding:8px 2px;
      border-bottom:1px solid var(--border)}
    .riwayat li:last-child{border-bottom:none}
    .riwayat .jam{color:var(--muted);flex:none}
  </style>
</head>
<body>

<!-- ============ LAYAR LOGIN ============ -->
<div id="authScreen" class="auth-screen">
  <div class="card auth-card">
    <h1>ABSEN MANDIRI</h1>
    <p class="muted">Masuk dengan akun yang diberikan panitia, lalu scan QR Anda.</p>
    <form id="loginForm">
      <input id="authEmail" type="email" placeholder="Email" required autocomplete="username">
      <input id="authPassword" type="password" placeholder="Kata sandi" required autocomplete="current-password">
      <button class="primary" type="submit" id="loginBtn">Masuk</button>
    </form>
    <div id="authMsg" class="result" hidden></div>
  </div>
</div>

<!-- ============ HALAMAN SCAN ============ -->
<div class="app" id="mainApp" hidden>
  <div class="scan-head">
    <div class="logo" id="appLogo"><span id="appLogoText">AQ</span></div>
    <div>
      <div class="t1" id="appName">Absensi QR</div>
      <div class="t2" id="userEmail"></div>
    </div>
    <div class="spacer"></div>
    <button type="button" class="mini-logout" id="logoutBtn">Keluar</button>
  </div>

  <div class="card">
    <h2>Scan QR Absen</h2>
    <p class="muted">Izinkan akses kamera, lalu arahkan QR pada Kartu ID Anda ke kamera.</p>

    <div class="reader-wrap">
      <div id="reader"></div>
      <div id="scanOverlay" class="scan-overlay">
        <div class="scan-overlay-icon"></div>
        <div class="scan-overlay-title"></div>
        <div class="scan-overlay-sub"></div>
      </div>
    </div>

    <div id="result" class="result">Menunggu scan...</div>
    <button id="startScan" class="primary">Mulai Kamera</button>
    <button id="stopScan" class="secondary">Matikan Kamera</button>
  </div>

  <div class="card" id="riwayatCard" hidden>
    <h2>Scan Berhasil di Sesi Ini</h2>
    <ul class="riwayat" id="riwayatList"></ul>
  </div>
</div>

<script type="module">
const $ = (id) => document.getElementById(id);

/* ============ KONEKSI SUPABASE (pakai config.js yang sama) ============ */
let db = null;
let configError = "";
try {
  const { SUPABASE_URL, SUPABASE_ANON_KEY } = await import("../config.js");
  if (!SUPABASE_URL || !SUPABASE_ANON_KEY) {
    configError = "config.js belum diisi dengan URL & anon key Supabase.";
  } else {
    db = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
  }
} catch (err) {
  configError = "Gagal memuat config.js: " + err.message;
}

/* ============ LOGIN ============ */
const authScreen = $("authScreen");
const mainApp = $("mainApp");
const loginForm = $("loginForm");
const authMsg = $("authMsg");
const loginBtn = $("loginBtn");

function showAuthMsg(text, type = "bad") {
  authMsg.hidden = false;
  authMsg.textContent = text;
  authMsg.className = "result " + type;
}

function applyAuthUI(session) {
  if (session && session.user) {
    authScreen.hidden = true;
    mainApp.hidden = false;
    $("userEmail").textContent = session.user.email || "";
    loadIdentitas();
    // Kamera langsung dinyalakan begitu masuk, supaya peserta tidak perlu
    // menekan tombol tambahan (tombol tetap ada sebagai cadangan).
    startScanner();
  } else {
    stopScanner();
    mainApp.hidden = true;
    authScreen.hidden = false;
  }
}

if (configError) {
  loginForm.hidden = true;
  showAuthMsg(configError, "bad");
} else {
  db.auth.getSession().then(({ data }) => applyAuthUI(data.session));
  db.auth.onAuthStateChange((_e, session) => applyAuthUI(session));

  loginForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    authMsg.hidden = true;
    loginBtn.disabled = true;
    loginBtn.textContent = "Memproses...";
    try {
      const { error } = await db.auth.signInWithPassword({
        email: $("authEmail").value.trim(),
        password: $("authPassword").value
      });
      if (error) throw error;
      $("authPassword").value = "";
    } catch (err) {
      showAuthMsg("Gagal masuk: " + err.message, "bad");
    } finally {
      loginBtn.disabled = false;
      loginBtn.textContent = "Masuk";
    }
  });

  $("logoutBtn").addEventListener("click", async () => {
    await stopScanner();
    await db.auth.signOut();
  });
}

/* ============ NAMA & LOGO APLIKASI ============ */
// Diambil dari tabel "pengaturan" (kunci "aplikasi") supaya halaman ini
// otomatis ikut nama & logo yang diatur admin di aplikasi utama.
async function loadIdentitas() {
  if (!db) return;
  try {
    const { data } = await db.from("pengaturan").select("nilai").eq("kunci", "aplikasi").maybeSingle();
    const nama = (data && data.nilai && data.nilai.nama) || "Absensi QR";
    const logo = data && data.nilai && data.nilai.logo;
    $("appName").textContent = nama;
    if (logo) {
      $("appLogo").innerHTML = `<img src="${logo}" alt="Logo">`;
    } else {
      $("appLogoText").textContent = nama.split(/\s+/).map(w => w[0] || "").join("").slice(0, 2).toUpperCase() || "AQ";
    }
    document.title = nama + " — Absen Mandiri";
  } catch { /* biarkan pakai nama bawaan kalau gagal */ }
}

/* ============ SCANNER ============ */
let scanner = null, scanning = false, lastCode = "", lastScanAt = 0, overlayTimer = null;

const SCAN_ICONS = {
  ok: '<svg viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  warn: '<svg viewBox="0 0 24 24" fill="none"><path d="M12 8v5M12 17h.01" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><path d="M10.6 3.9 2.4 18a1.6 1.6 0 0 0 1.4 2.4h16.4a1.6 1.6 0 0 0 1.4-2.4L13.4 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke="#fff" stroke-width="2.4" stroke-linejoin="round"/></svg>',
  bad: '<svg viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6 6 18" stroke="#fff" stroke-width="3" stroke-linecap="round"/></svg>'
};

function showScanOverlay(type, title, sub = "") {
  const el = $("scanOverlay");
  clearTimeout(overlayTimer);
  el.querySelector(".scan-overlay-icon").innerHTML = SCAN_ICONS[type] || SCAN_ICONS.bad;
  el.querySelector(".scan-overlay-title").textContent = title;
  el.querySelector(".scan-overlay-sub").textContent = sub;
  el.className = "scan-overlay show " + type;
  overlayTimer = setTimeout(() => { el.className = "scan-overlay"; }, 2200);
}

function showResult(html, type) {
  $("result").innerHTML = html;
  $("result").className = "result " + type;
}

async function startScanner() {
  if (scanning) return;
  $("result").textContent = "Membuka kamera...";
  scanner = new Html5Qrcode("reader");
  try {
    await scanner.start(
      { facingMode: "environment" },
      { fps: 10, qrbox: { width: 250, height: 250 } },
      handleScan,
      () => {}
    );
    scanning = true;
    $("result").textContent = "Kamera aktif. Silakan scan QR.";
  } catch {
    $("result").textContent = "Kamera gagal dibuka. Pastikan izin kamera aktif dan halaman diakses lewat HTTPS.";
  }
}

async function stopScanner() {
  if (!scanner || !scanning) return;
  try { await scanner.stop(); scanner.clear(); } catch {}
  scanning = false;
  $("result").textContent = "Kamera dimatikan.";
}

$("startScan").addEventListener("click", startScanner);
$("stopScan").addEventListener("click", stopScanner);

/* ============ LOGIKA ABSEN (sama persis dengan aplikasi utama) ============ */

// QR bisa berisi UUID polos (kartu lama) atau link profil.html?kode=UUID (kartu baru).
function extractKodeQr(scannedText) {
  try {
    const kode = new URL(scannedText).searchParams.get("kode");
    if (kode) return kode;
  } catch { /* bukan URL -> anggap kode langsung */ }
  return scannedText;
}

// Tanggal menurut waktu LOKAL perangkat, bukan UTC. Kalau pakai toISOString()
// mentah, absen jam 00:00-06:59 WIB akan tersimpan dengan tanggal KEMARIN.
function localDateStr(d = new Date()) {
  return new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
}

function jamPendek(v) { return v ? String(v).slice(0, 5) : "-"; }

function esc(v = "") {
  return String(v).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
}

function catatRiwayat(nama, jam) {
  $("riwayatCard").hidden = false;
  const li = document.createElement("li");
  li.innerHTML = `<span>${esc(nama)}</span><span class="jam">${esc(jam)}</span>`;
  $("riwayatList").prepend(li);
}

async function handleScan(code) {
  if (!db) return showResult(esc(configError), "bad");

  const now = Date.now();
  if (code === lastCode && now - lastScanAt < 3000) return;
  lastCode = code; lastScanAt = now;

  const kode = extractKodeQr(code);
  const { data: peserta, error } = await db
    .from("peserta").select("*").eq("kode_qr", kode).maybeSingle();

  if (error) {
    showScanOverlay("bad", "GAGAL", "Gagal membaca data peserta.");
    return showResult("Gagal membaca data peserta: " + esc(error.message), "bad");
  }
  if (!peserta) {
    showScanOverlay("bad", "TIDAK TERDAFTAR", "QR tidak dikenali.");
    return showResult("QR tidak terdaftar.", "bad");
  }

  const today = localDateStr();
  const { data: existing } = await db
    .from("kehadiran").select("*")
    .eq("peserta_id", peserta.id).eq("tanggal", today).maybeSingle();

  if (existing) {
    showScanOverlay("warn", "SUDAH ABSEN", `${peserta.nama} — ${jamPendek(existing.jam)}`);
    return showResult(`⚠️ SUDAH ABSEN<br><b>${esc(peserta.nama)}</b><br>${jamPendek(existing.jam)}`, "warn");
  }

  // Kolom "jam" bertipe time di Postgres, hanya menerima "HH:MM" (pakai titik dua).
  // Jangan pakai toLocaleTimeString("id-ID") yang memakai TITIK sebagai pemisah.
  const n = new Date();
  const jamSekarang = String(n.getHours()).padStart(2, "0") + ":" + String(n.getMinutes()).padStart(2, "0");

  const { error: insertError } = await db.from("kehadiran").insert({
    peserta_id: peserta.id,
    tanggal: today,
    jam: jamSekarang
  });

  if (insertError) {
    // Kalau dua peserta/HP men-scan kartu yang sama nyaris bersamaan, insert kedua
    // akan kena unique constraint. Tampilkan sebagai "SUDAH ABSEN", bukan error mentah.
    const isDuplicate = insertError.code === "23505" ||
      /duplicate key|unique constraint/i.test(insertError.message || "");
    if (isDuplicate) {
      const { data: nowExisting } = await db
        .from("kehadiran").select("*")
        .eq("peserta_id", peserta.id).eq("tanggal", today).maybeSingle();
      const jamTampil = nowExisting ? jamPendek(nowExisting.jam) : jamSekarang;
      showScanOverlay("warn", "SUDAH ABSEN", `${peserta.nama} — ${jamTampil}`);
      return showResult(`⚠️ SUDAH ABSEN<br><b>${esc(peserta.nama)}</b><br>${jamTampil}`, "warn");
    }
    showScanOverlay("bad", "GAGAL", "Gagal menyimpan kehadiran.");
    return showResult("Gagal menyimpan: " + esc(insertError.message), "bad");
  }

  showScanOverlay("ok", "ABSENSI BERHASIL", `${peserta.nama}${peserta.asal_sekolah ? " — " + peserta.asal_sekolah : ""}`);
  showResult(`✅ ABSEN BERHASIL<br><b>${esc(peserta.nama)}</b><br>${esc(peserta.asal_sekolah || "-")}`, "ok");
  catatRiwayat(peserta.nama, jamSekarang);
}
</script>
</body>
</html>
